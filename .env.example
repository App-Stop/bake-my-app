# Copy to .env.local for development. Set the same variables in the Vercel project for deployments.
# Only public values belong here: never a Stripe secret key or any other secret.

# Backend base URL, no trailing slash.
VITE_API_URL=http://localhost:3060

# Cloudflare Turnstile site key; only once the backend switches the bot challenge on.
VITE_TURNSTILE_SITE_KEY=
